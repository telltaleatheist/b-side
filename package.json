{
  "name": "b-side",
  "productName": "B-Sides",
  "version": "0.1.4",
  "author": "Owen Morgan",
  "description": "B-Sides — write the style and the lyrics, make songs with YuE2 on a Crucible server, and listen while more generate.",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "ng": "ng",
    "clean:electron": "shx rm -rf dist/electron dist/shared",
    "build:electron": "npm run clean:electron && tsc -p tsconfig.electron.json",
    "build:renderer": "npm run test:templates && ng build",
    "build": "npm run build:electron && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "bun test",
    "start": "npm run electron:dev",
    "electron:dev": "npm run build:electron && node tools/free-port.cjs 4270 && concurrently -k -n ng,electron \"ng serve --port 4270\" \"wait-on http-get://localhost:4270 && electron . --dev\"",
    "electron:prod": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac-arm64": "npm run build && electron-builder --mac --arm64",
    "package:mac-x64": "npm run build && electron-builder --mac --x64",
    "package:win": "npm run build && electron-builder --win",
    "package:win-x64": "npm run build && electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux",
    "package:ios": "bash mobile/package-ios.sh",
    "test:templates": "node tools/test-no-backticks-in-templates.js"
  },
  "_crucibleClientNote": "The Crucible SDK (@crucible/client) and its installer library (@crucible/bootstrap) are vendored as immutable npm-pack tarballs from the GitHub release (there is no registry publish). Compatibility with a server is the API version on X-Crucible-Api, not this number. To update: node tools/adopt-crucible-release.mjs <version> (BookForge's script, copied per crucible docs/INTEGRATING-AN-APP.md §2.2; name the version, since --newest reads the newest tag rather than the promoted release; --check shows both).",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@capacitor/core": "8.4.1",
    "@crucible/bootstrap": "file:vendor/crucible-bootstrap-1.0.118.tgz",
    "@crucible/client": "file:vendor/crucible-client-1.0.118.tgz",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "^20.11.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "shx": "^0.4.0",
    "typescript": "~5.9.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.owenmorgan.bside",
    "productName": "B-Sides",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "dist/shared/**/*",
      "dist/renderer/**/*",
      "public/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/@angular/**",
      "!node_modules/@capacitor/**",
      "!node_modules/@fontsource/**",
      "!node_modules/rxjs/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "public/icon-mac.png"
    },
    "dmg": {
      "artifactName": "B-Sides-${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "B-Sides",
      "artifactName": "B-Sides-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "B-Sides-Portable-${version}.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Audio",
      "icon": "public/icon.png"
    }
  }
}
