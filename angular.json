{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "b-side": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": { "style": "scss", "skipTests": true }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/renderer",
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "styles": [
              "node_modules/@fontsource/big-shoulders-display/700.css",
              "node_modules/@fontsource/big-shoulders-display/800.css",
              "node_modules/@fontsource/big-shoulders-display/900.css",
              "node_modules/@fontsource/instrument-sans/400.css",
              "node_modules/@fontsource/instrument-sans/500.css",
              "node_modules/@fontsource/instrument-sans/600.css",
              "node_modules/@fontsource/ibm-plex-mono/400.css",
              "node_modules/@fontsource/ibm-plex-mono/500.css",
              "src/styles.scss"
            ],
            "assets": [{ "glob": "**/*", "input": "public" }]
          },
          "configurations": {
            "production": {
              "baseHref": "./",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              },
              "budgets": [
                { "type": "initial", "maximumWarning": "500kB", "maximumError": "2MB" },
                { "type": "anyComponentStyle", "maximumWarning": "24kB", "maximumError": "48kB" }
              ],
              "outputHashing": "all"
            },
            "mobile": {
              "outputPath": "dist/mobile",
              "baseHref": "./",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              },
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "b-side:build:production" },
            "development": { "buildTarget": "b-side:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
